# Git config --global
# source: https://github.com/dlvhdr/dotfiles/blob/main/.config/git/config

[alias]
  # General
  aliases = !git config --list | grep 'alias\\.' | sed 's/alias\\.\\([^=]*\\)=\\(.*\\)/\\1\\ \t => \\2/' | sort
  clean-branches = !git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
  branches = branch --sort=-authordate
  last = log -1 HEAD
  unstage = reset HEAD --
  stashes = stash list
  remotes = remote -v
  main = master
  
  # Preferred git log view
  lg = log --graph --abbrev-commit --decorate --format=format:'%C(yellow)%h%C(reset) %C(white)%s%C(reset) %C(dim white)-%C(reset) %ar %C(dim white)<%an>%C(reset)%C(auto)%d%C(reset)' --all
  lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(yellow)%h%C(reset) %C(white)%s%C(reset) %C(dim white)-%C(reset) %ar %C(dim white)<%an>%C(reset)%C(auto)%d%C(reset)%n' --all --stat

  # Delete local branches that no longer exist on the remote
  gone = !git fetch -p && git branch -vv | grep 'origin/.*: gone]' | awk '{print $1}' | xargs git branch -D
 
[color]
  ui = true

[core]
  editor = nvim
  excludesfile = ~/.config/git/ignore
  pager = delta

[delta]
  features = catppuccin-mocha # delta theme
  # features = tokyonight-night # delta theme
  # features = decorations # delta theme
  navigate = true    
  light = false      
  side-by-side = true  
  line-numbers = true   
[delta "interactive"]
  keep-plus-minus-markers = true
[delta "decorations"]
  commit-decoration-style = blue ol
  commit-style = raw
  file-style = omit
  hunk-header-decoration-style = blue box
  hunk-header-file-style = red
  hunk-header-line-number-style = "#067a00"
  hunk-header-style = file line-number syntax

[diff]
  colorMoved = default

[fetch]
	prune = true

[github]
  user = shamindras

[help]
  # Autocorrect mistyped commands.
  autocorrect = 1

[init]
  defaultBranch = main

[include]
  # delta themes
  # source: https://dandavison.github.io/delta/custom-themes.html
  path = ~/.config/delta/themes.gitconfig

[interactive]
  diffFilter = delta --color-only --features=interactive

[merge]
  conflictstyle = diff3
  tool = vimdiff

[mergetool]
  path = nvim

[pull]
	rebase = true

[push]
  default = current
  autoSetupRemote = true

[rebase]
  updateRefs = true

[rerere]
  enabled = true

[gpg]
	format = ssh
[format]
	signoff = true

# HTTPS everywhere; gh supplies the credentials (no SSH key needed to clone).
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential

# Identity, signing key and allowed signers come from the profile: install
# links generated/<profile>/gitconfig to ~/.config/dotfiles/gitconfig, and
# setup-github-auth writes the work email to ~/.config/dotfiles/gitconfig.local
# (never in the repo). Later files override earlier ones; missing files are
# skipped by git.
[include]
  path = ~/Library/CloudStorage/Dropbox/repos/dotfiles/config/git/transitional.gitconfig # transitional
[include]
  path = ~/.config/dotfiles/gitconfig
[include]
  path = ~/.config/dotfiles/gitconfig.local
