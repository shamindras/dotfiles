#!/usr/bin/env bash
# brew-update — canonical Homebrew update pipeline.
#
# Invoked by the `bu` zsh alias, and the Hammerspoon
# leader `RCmd → r → b`. Flow: Caskroom sweep (*.upgrading orphans +
# .metadata-only stubs) → tri-state mode detect (steady / drift /
# bootstrap) → manifest drift report (read-only) → brew update → brew
# upgrade --greedy (tolerant) → brew bundle install (recovery + bootstrap)
# → brew cleanup → emoji summary. Sudo is invoked lazily — only when the
# Caskroom sweep has orphans to remove or when brew itself escalates for a
# pkg-shaped cask — so quiet runs never prompt for a password.
#
# The Brewfile is this profile's generated/<profile>/Brewfile (rendered from
# manifest.json). brew-update never writes it or the manifest: packages
# installed but not in the manifest, or in the manifest but not installed,
# are reported with the command that resolves them, and nothing missing is
# installed behind your back (./install does that).

set -Eeuo pipefail

# Resolve dotfiles root via the parent-dir symlink. The script file itself
# is not symlinked — only ~/.config/bin (points at <repo>/config/bin).
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
DOTFILES_DIR="$(cd "$SCRIPT_DIR/../.." && pwd -P)"

BREW="/opt/homebrew/bin/brew"
# This profile's Brewfile, through the registry link install creates.
REGISTRY="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/resolved.json"
if [ -L "$REGISTRY" ]; then
  GEN_DIR="$(cd "$(dirname "$(readlink "$REGISTRY")")" && pwd -P)"
else
  # transitional: until install links ~/.config/dotfiles on this Mac (N16)
  GEN_DIR="$DOTFILES_DIR/generated/home"
  REGISTRY="$GEN_DIR/resolved.json"
fi
PROFILE="$(basename "$GEN_DIR")"
BREWFILE="$GEN_DIR/Brewfile"

# Autoremove is the default in modern brew; setting HOMEBREW_AUTOREMOVE=1
# triggers a deprecation warning. We drop it here in case a stale shell
# still exports the value from before the env-vars config was updated.
#
# The remaining exports mirror the brew behavior vars set in
# config/zsh/conf.d/01-z1-env-vars-gen.zsh so the Hammerspoon → wezterm →
# `zsh -c` dispatch path (non-interactive, .zshrc not sourced) gets the
# same brew env as `bu` from an interactive shell. The zsh config remains
# authoritative for interactive shells; this block is a self-containment
# shim for the no-TTY path.
unset HOMEBREW_AUTOREMOVE
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_UPDATE_REPORT_NEW=1
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_UPGRADE_GREEDY=1
# Script-local (not mirrored from zsh): brew 6.x prompts for confirmation
# before each `brew upgrade` batch ("Do you want to proceed? [y/n]"). The
# bu pipeline is always-yes by design — the dump/upgrade/bundle-install
# sequence is the canonical brew-state refresh. Setting NO_ASK only here
# keeps ad-hoc `brew upgrade` calls from a normal shell still prompting.
export HOMEBREW_NO_ASK=1

# --- No-TTY → WezTerm popup dispatch --------------------------------------
# Triggered when invoked without a controlling TTY — Hammerspoon's hs.task
# spawns subprocesses with no TTY (Raycast scripts, cron, etc. would
# behave the same way). brew shells out to interactive `sudo` for
# pkg-shaped cask installs, and step 1's Caskroom sweep does the same;
# both silently fail without a TTY to read the password from. run-as-user
# is kept in the call chain so the dispatch also works when the script is
# invoked under sudo (a no-op as the console user).
if [ "$(id -u)" -eq 0 ] || ! [ -t 0 ]; then
  RUN="$HOME/.config/bin/run-as-user"
  WEZTERM="/Applications/WezTerm.app/Contents/MacOS/wezterm"
  exec "$RUN" "$WEZTERM" start -- /bin/zsh -c \
    "'$0'; printf '\n===[ BREW UPDATE END ]===\n'; printf '\nPress any key to close this window...'; read -k 1 -s"
fi

# --- Running as the console user with a TTY from here --------------------
SECONDS=0
RED=$'\033[0;31m'; YEL=$'\033[0;33m'; GRN=$'\033[0;32m'
DIM=$'\033[2m';    NC=$'\033[0m'

PRE_F=$(mktemp -t brew-update); PRE_C=$(mktemp -t brew-update)
MID_F=$(mktemp -t brew-update); MID_C=$(mktemp -t brew-update)
POST_C=$(mktemp -t brew-update); CLEAN_LOG=$(mktemp -t brew-update)
INST_F=$(mktemp -t brew-update); INST_C=$(mktemp -t brew-update)
KEEP_BREWFILE=$(mktemp -t brew-update)

cleanup_tmp() {
  rm -f "$PRE_F" "$PRE_C" "$MID_F" "$MID_C" "$POST_C" "$CLEAN_LOG" \
        "$INST_F" "$INST_C" "$KEEP_BREWFILE"
}
trap cleanup_tmp EXIT

# Step 1 — Sweep broken cask state that would mislead mode detection.
# Two shapes of corruption to clean up first:
#
#   1. `*.upgrading` directories: `brew cask upgrade` renames
#      `<VER>` → `<VER>.upgrading`, reinstalls, then removes the marker.
#      A partial failure (typical for pkg-shaped auto_updates casks like
#      nordvpn / zoom / xquartz) leaves the marker behind,
#      and every subsequent `brew upgrade --greedy` throws
#      `No such file or directory @ rb_file_s_rename` on that cask.
#
#   2. Stub Caskroom dirs (only `.metadata`, no version subdir): a
#      crashed uninstall or `brew update-reset` can leave this behind.
#      `brew list --cask` still reports the cask as installed (directory
#      exists) but it is not really installed, so if step 2 trusts
#      `brew list`, mode is (wrongly) detected as steady and the drift
#      report misses it.
#
# Wiping both here makes the installed-cask check in step 2 (mode
# detection) reflect the true state — they become missing → drift mode
# fires → preview warns the user with an actionable list.
CASKROOM="/opt/homebrew/Caskroom"
SWEEP=()
if [ -d "$CASKROOM" ]; then
  while IFS= read -r d; do
    [ -n "$d" ] && SWEEP+=("$d|upgrading")
  done < <(find "$CASKROOM" -name '*.upgrading' 2>/dev/null || true)
  for d in "$CASKROOM"/*/; do
    [ -d "$d" ] || continue
    # Any non-.metadata entry means a real version is installed.
    if ! find "$d" -mindepth 1 -maxdepth 1 ! -name '.metadata' \
           2>/dev/null | grep -q .; then
      SWEEP+=("$d|stub")
    fi
  done
fi
if [ "${#SWEEP[@]}" -eq 0 ]; then
  printf '🧹 [1/7] Caskroom sweep: nothing to clean\n'
else
  printf '🧹 [1/7] Sweeping %d broken Caskroom dir(s)\n' "${#SWEEP[@]}"
  for entry in "${SWEEP[@]}"; do
    path="${entry%|*}"; kind="${entry##*|}"
    if [ "$kind" = upgrading ]; then
      printf '   %s✂  %s (orphaned .upgrading)%s\n' "$DIM" "$path" "$NC"
    else
      printf '   %s✂  %s (stub — only .metadata)%s\n' "$DIM" "$path" "$NC"
    fi
    sudo rm -rf "$path"
  done
fi

# Step 2 — Tri-state mode detection.
#   steady    : every declared formula/cask is present in `brew list`.
#               Outdated versions are fine — step 5 handles upgrades.
#   drift     : some declared entries are absent from `brew list`, but
#               brew is populated (user ran `brew uninstall foo`, or a
#               prior run crashed mid-pipeline and left something out).
#   bootstrap : brew is (near-)empty relative to the Brewfile — fresh
#               machine. Everything declared is installed in step 6.
#
# We check set membership against `brew list` directly rather than using
# `brew bundle check`, because bundle check flags *both* missing AND
# outdated packages as failing — lumping "user uninstalled this" together
# with "needs a normal version bump" and causing false drift triggers on
# every routine run. The pre-step-2 sweep above ensures `brew list`'s
# view matches what is really installed.
"$BREW" list --formula >"$INST_F" 2>/dev/null || true
"$BREW" list --cask    >"$INST_C" 2>/dev/null || true

MISSING_LIST=$(awk -v fpath="$INST_F" -v cpath="$INST_C" '
  BEGIN {
    while ((getline n < fpath) > 0) installed_f[n] = 1
    close(fpath)
    while ((getline n < cpath) > 0) installed_c[n] = 1
    close(cpath)
  }
  /^brew "/ {
    match($0, /"[^"]+"/)
    full = substr($0, RSTART+1, RLENGTH-2)
    name = full; sub(/^.*\//, "", name)
    if (!(name in installed_f)) printf "       brew \"%s\"\n", full
  }
  /^cask "/ {
    match($0, /"[^"]+"/)
    full = substr($0, RSTART+1, RLENGTH-2)
    name = full; sub(/^.*\//, "", name)
    if (!(name in installed_c)) printf "       cask \"%s\"\n", full
  }
' "$BREWFILE")
# A declared formula whose command already exists outside Homebrew (rust's
# rustup from the rustup.rs installer in $CARGO_HOME, before the move to
# brew's rustup) is not drift: report it as provided elsewhere instead.
OUTSIDE_LIST=""
KEPT_MISSING=""
while IFS= read -r line; do
  [ -n "$line" ] || continue
  name=$(printf '%s' "$line" | sed -E 's/^ *(brew|cask) "([^"]+)".*/\2/' | sed 's|.*/||')
  # Also look in $CARGO_HOME/bin: the Hammerspoon path runs a non-interactive
  # zsh, whose PATH lacks it.
  where=$(PATH="$PATH:${CARGO_HOME:-$HOME/.local/share/cargo}/bin" command -v "$name" 2>/dev/null || true)
  case "$line" in
    *'brew "'*)
      if [ -n "$where" ] && case "$where" in "$(dirname "$(dirname "$BREW")")"/*) false ;; *) true ;; esac; then
        OUTSIDE_LIST="${OUTSIDE_LIST}${name} (${where})"$'\n'
        continue
      fi
      ;;
  esac
  KEPT_MISSING="${KEPT_MISSING}${line}"$'\n'
done <<<"$MISSING_LIST"
MISSING_LIST="$KEPT_MISSING"
OUTSIDE_N=$(printf '%s' "$OUTSIDE_LIST" | grep -c . || true)
MISSING_COUNT=$(printf '%s' "$MISSING_LIST" | grep -c '^ ' || true)

if [ "$MISSING_COUNT" -eq 0 ]; then
  MODE=steady
else
  BREWFILE_ENTRIES=$(grep -cE '^(brew|cask) "' "$BREWFILE" 2>/dev/null || echo 0)
  TOTAL_INSTALLED=$(($(wc -l <"$INST_F") + $(wc -l <"$INST_C")))
  if [ "$BREWFILE_ENTRIES" -eq 0 ] || \
     [ "$TOTAL_INSTALLED" -lt $((BREWFILE_ENTRIES / 2)) ]; then
    MODE=bootstrap
    MISSING_LIST=""
  else
    MODE=drift
  fi
fi
printf '🧭 [2/7] Mode: %s\n' "$MODE"

# Step 3 — Manifest drift report (read-only). Two directions:
#   NOT_DECLARED : installed on request (or a cask) but not in this
#                  profile's Brewfile (installed by hand, or dropped from
#                  the manifest).
#   MISSING_LIST : in the manifest but not installed (new in the manifest,
#                  or uninstalled by hand; brew-update cannot tell which).
#                  Drift mode leaves these out of step 6: run ./install or
#                  brew install to add a new one. Bootstrap mode installs all.
printf '📋 [3/7] Manifest drift (%s profile)\n' "$PROFILE"
DECLARED=$(sed -nE 's/^(brew|cask) "([^"]+)".*/\2/p' "$BREWFILE" | sed 's|.*/||' | sort -u)
NOT_DECLARED=$(comm -13 <(printf '%s\n' "$DECLARED") \
  <( ("$BREW" leaves --installed-on-request 2>/dev/null; cat "$INST_C") | sed 's|.*/||' | sort -u) \
  | grep . || true)
NOT_DECLARED_N=$(printf '%s' "$NOT_DECLARED" | grep -c . || true)
MISSING_N=0
if [ "$MODE" = drift ]; then MISSING_N=$MISSING_COUNT; fi
printf '   %d installed but not in the manifest, %d in the manifest but not installed\n' "$NOT_DECLARED_N" "$MISSING_N"
# Step 6 reinstalls only what upgrades dropped, not by-hand uninstalls.
if [ "$MODE" = drift ] && [ -n "$MISSING_LIST" ]; then
  grep -vxF -f <(printf '%s\n' "$MISSING_LIST" | sed 's/^ *//') "$BREWFILE" >"$KEEP_BREWFILE" || true
else
  cp "$BREWFILE" "$KEEP_BREWFILE"
fi
unit_of() { # unit_of <package> -> manifest unit that owns it (or the name)
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("packages",{}).get(sys.argv[2], sys.argv[2]))' \
    "$REGISTRY" "$1" 2>/dev/null || printf '%s\n' "$1"
}

"$BREW" list --versions --formula >"$PRE_F" || true
"$BREW" list --versions --cask    >"$PRE_C" || true

# Step 4 — Refresh taps.
printf '🔄 [4/7] brew update\n'
"$BREW" update

# Step 5 — Greedy upgrade. Tolerated: pkg-shaped auto_updates casks
# (nordvpn, xquartz, zoom) fail the uninstall→reinstall cycle and exit
# non-zero; step 6 re-installs anything step 5 silently dropped.
printf '⬆️  [5/7] brew upgrade --greedy (tolerant of individual cask failures)\n'
UPGRADE_EXIT=0
"$BREW" upgrade --greedy || UPGRADE_EXIT=$?

"$BREW" list --versions --formula >"$MID_F" || true
"$BREW" list --versions --cask    >"$MID_C" || true

# Step 6 — Reconcile against Brewfile. Upgrade-by-default, so this both
# bootstraps missing entries and recovers anything step 5 dropped.
printf '🔧 [6/7] brew bundle install (recovery + bootstrap)\n'
BUNDLE_EXIT=0
"$BREW" bundle install --file="$KEEP_BREWFILE" || BUNDLE_EXIT=$?

"$BREW" list --versions --cask >"$POST_C" || true

# Step 7 — Cleanup.
printf '🧹 [7/7] brew cleanup\n'
"$BREW" cleanup 2>&1 | tee "$CLEAN_LOG" || true

# --- Summary -------------------------------------------------------------
upgraded_count() {
  awk 'NR==FNR { pre[$1]=$0; next }
       { if (($1 in pre) && pre[$1] != $0) c++ } END { print c+0 }' "$1" "$2"
}
missing_names() {
  awk 'NR==FNR { a[$1]=1; next } { delete a[$1] }
       END { for (k in a) print k }' "$1" "$2" | sort -u
}

FORMULAE_UP=$(upgraded_count "$PRE_F" "$MID_F")
CASKS_UP=$(upgraded_count "$PRE_C" "$MID_C")
# Truth-anchored cask diffs:
#   DROPPED      = PRE \ MID  (briefly absent during the upgrade window)
#   UNRECOVERED  = PRE \ POST (still absent at the end — the REAL loss)
#   RECOVERED    = DROPPED \ UNRECOVERED (dropped, came back by POST)
# Anchoring UNRECOVERED to PRE→POST (not DROPPED→RECOVERED) makes the
# summary robust to transient mid-pipeline snapshot anomalies. Brew 6.x
# `brew upgrade --greedy` can rewrite cask metadata such that an
# immediately-following `brew list --cask` momentarily returns empty —
# without this anchoring, every cask in PRE would be flagged as needing
# manual recovery even though POST is fine.
DROPPED=$(missing_names "$PRE_C" "$MID_C")
UNRECOVERED=$(missing_names "$PRE_C" "$POST_C")
RECOVERED=$(comm -23 <(printf '%s\n' "$DROPPED"     | sort -u) \
                     <(printf '%s\n' "$UNRECOVERED" | sort -u) \
              | grep -v '^$' || true)
DROPPED_N=$(printf '%s' "$DROPPED"       | grep -c . || true)
RECOVERED_N=$(printf '%s' "$RECOVERED"   | grep -c . || true)


DISK_FREED=$(grep -oE 'freed approximately [0-9.]+ *[KMGT]?B' "$CLEAN_LOG" \
  | sed -E 's/freed approximately *//' | tail -1 || true)
DISK_FREED="${DISK_FREED:-0B}"

# Single if-block (not `cmd && ZERO=0` chain) so set -e can't interact
# with short-circuits — defensive, since the summary must always print.
ZERO=1
if [ "$FORMULAE_UP"    -gt 0 ]      \
|| [ "$CASKS_UP"       -gt 0 ]      \
|| [ "$DROPPED_N"      -gt 0 ]      \
|| [ "$RECOVERED_N"    -gt 0 ]      \
|| [ "$NOT_DECLARED_N" -gt 0 ]      \
|| [ "$MISSING_N"      -gt 0 ]      \
|| [ "$DISK_FREED"     != 0B ]; then
  ZERO=0
fi

printf '\n'
if [ "$ZERO" -eq 1 ] && [ "$UPGRADE_EXIT" -eq 0 ] && [ "$BUNDLE_EXIT" -eq 0 ]; then
  printf '%s✅ Nothing to do (%ds)%s\n' "$GRN" "$SECONDS" "$NC"
else
  printf '🍺 brew-update summary\n'
  printf '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
  printf '📋 Manifest (%s):     %d not in the manifest, %d not installed (mode: %s)\n' \
    "$PROFILE" "$NOT_DECLARED_N" "$MISSING_N" "$MODE"
  if [ "$NOT_DECLARED_N" -gt 0 ]; then
    printf '%s\n' "$NOT_DECLARED" | while IFS= read -r name || [ -n "$name" ]; do
      if [ -n "$name" ]; then
        printf '   %s➕ %s%s installed but not in the manifest: declare it in manifest.json, or brew uninstall %s\n' \
          "$GRN" "$name" "$NC" "$name"
      fi
    done
  fi
  if [ "$MISSING_N" -gt 0 ]; then
    printf '%s\n' "$MISSING_LIST" | sed -E 's/^ *(brew|cask) "([^"]+)"/\2/' | sed 's|.*/||' \
      | while IFS= read -r name || [ -n "$name" ]; do
      if [ -n "$name" ]; then
        printf '   %s➖ %s%s in the manifest but not installed: brew install %s (or ./install), or just manifest_set %s %s off\n' \
          "$YEL" "$name" "$NC" "$name" "$PROFILE" "$(unit_of "$name")"
      fi
    done
  fi
  if [ "$OUTSIDE_N" -gt 0 ]; then
    printf '%s\n' "$OUTSIDE_LIST" | while IFS= read -r entry || [ -n "$entry" ]; do
      if [ -n "$entry" ]; then printf '   %s· %s provided outside Homebrew%s\n' "$DIM" "$entry" "$NC"; fi
    done
  fi
  printf '⬆️  Upgraded:          %s formulae, %s casks\n' "$FORMULAE_UP" "$CASKS_UP"
  if [ "$DROPPED_N" -gt 0 ]; then
    printf '%s⚠️  Silently dropped: %d (%s)%s\n' \
      "$YEL" "$DROPPED_N" "$(printf '%s' "$DROPPED" | tr '\n' ' ')" "$NC"
  else
    printf '⚠️  Silently dropped: 0\n'
  fi
  if [ "$RECOVERED_N" -gt 0 ]; then
    printf '🔧 Recovered:         %d (%s)\n' \
      "$RECOVERED_N" "$(printf '%s' "$RECOVERED" | tr '\n' ' ')"
  else
    printf '🔧 Recovered:         0\n'
  fi
  printf '🧹 Cleanup freed:     %s\n' "$DISK_FREED"
  printf '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'

  if [ -n "$UNRECOVERED" ]; then
    printf '%s⚠️  Unrecovered (needs manual fix): %s%s\n' \
      "$RED" "$(printf '%s' "$UNRECOVERED" | tr '\n' ' ')" "$NC"
  fi
  if [ "$UPGRADE_EXIT" -ne 0 ]; then
    printf '%s… upgrade step exited %d (tolerated)%s\n' \
      "$DIM" "$UPGRADE_EXIT" "$NC"
  fi
  if [ "$BUNDLE_EXIT" -ne 0 ]; then
    printf '%s❌ bundle install step exited %d%s\n' \
      "$RED" "$BUNDLE_EXIT" "$NC"
  fi

  printf '%s✅ Done in %ds%s\n' "$GRN" "$SECONDS" "$NC"
fi
