#!/bin/sh
# leader-hud — update sketchybar leader key HUD
#
# Called at each leader-layer transition by Hammerspoon to show the
# available keys or dismiss the HUD. run-as-user is a no-op wrapper
# here (Hammerspoon already runs as the console user).
#
# Usage:
#   leader-hud show <group>   Show HUD label for group
#   leader-hud hide           Hide HUD

# Caller-agnostic PATH. hs.task spawns subprocesses with the minimal
# default PATH (/usr/bin:/bin:/usr/sbin:/sbin), so /opt/homebrew/bin
# isn't searched — sketchybar then can't be located and the script
# silently exits 127. Prepending Homebrew makes the script portable
# regardless of how it's invoked.
PATH="/opt/homebrew/bin:$PATH"
export PATH

set -eu

SCRIPT_DIR="$(dirname "$0")"
RUN_AS_USER="$SCRIPT_DIR/run-as-user"

ACTION="${1:?Usage: leader-hud show|hide [group]}"
GROUP="${2:-}"

case "$ACTION" in
  show)
    case "$GROUP" in
      leader)
        LABEL="▸ o:󰏋 q:󰅖 r:󰜎 c:󰚩 s:󰍉 g:󰊤 u:󰌷"
        ;;
      open)
        LABEL="(o)▸ a:󰈔 b:󰈹 d:󰋩 e:󰉋 g:󰭹 i:󰂽 m:󰓇 n:󰤨 p:󰈙 q:󰏫 s:󰨞 t:󰊠 u:󰍬 v:󰕼 w:󰆍 x:󰇚 1:󰌋 9:󰍹"
        ;;
      quit)
        LABEL="(q)▸ a:󰈔 b:󰈹 d:󰋩 e:󰉋 g:󰭹 i:󰂽 m:󰓇 n:󰤨 p:󰈙 q:󰏫 s:󰨞 t:󰊠 u:󰍬 v:󰕼 w:󰆍 x:󰇚 1:󰌋 9:󰍹"
        ;;
      claude)
        LABEL="(c)▸ n:󰎔 r:󰋚 u:󰄨"
        ;;
      run)
        LABEL="(r)▸ b:󰏗 c:󰂜 e:󰈻 i:󰈔 m:󰉏 r:󰑓 t:󰩹 u:󰖁 w:󰛌"
        ;;
      search)
        LABEL="(s)▸ b:󰃀 c:󰅇 f:󰈞"
        ;;
      github)
        LABEL="(g)▸ b:󰖟 c:󰗀 d:󰉋 g:󰊤 n:󰎐"
        ;;
      urls)
        LABEL="(u)▸ b:󰖟 h:󰋜 i:󰗃 k:󰷐 l:󰌻 w:󰖙"
        ;;
      *)
        echo "leader-hud: unknown group '$GROUP'" >&2
        exit 1
        ;;
    esac
    "$RUN_AS_USER" sketchybar --set leader label="$LABEL" drawing=on
    ;;
  hide)
    "$RUN_AS_USER" sketchybar --set leader drawing=off
    ;;
  *)
    echo "leader-hud: unknown action '$ACTION'" >&2
    exit 1
    ;;
esac
