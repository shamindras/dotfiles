#!/usr/bin/env bash
#
# install — link configs, install packages and run setup steps for one profile.
#
# Usage:
#   ./install [--profile <name>] [--links-only | --dry-run] [--no-hints]
#
#   --profile <name>  home or work (any profile under generated/). Needed on the
#                     first run; later runs read the profile from the link
#                     ~/.config/dotfiles/resolved.json -> generated/<profile>/.
#   --links-only      create directories and links only (no Homebrew, no setup
#                     steps, no sudo). Used by the throwaway-HOME tests.
#   --dry-run         change nothing: print the dotbot plan, the package
#                     modules and the setup steps.
#   --no-hints        skip the post-install reminders.
#
# Everything resolves from this script's own folder, so any clone path works.
# Reads only committed files under generated/<profile>/ (rendered from
# manifest.json); the resolver is never needed here.
#
# Fault isolation: packages install one module at a time, core first; a
# module that fails falls back to one package at a time, and failures are
# collected into the summary. Setup steps whose commands are missing are
# skipped with a reason (see `needs` in manifest.json). Exits non-zero only
# at the end, when something failed.

set -Eeuo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$BASEDIR"

# shellcheck source=scripts/_lib/step.sh
source "$BASEDIR/scripts/_lib/step.sh"

PROFILE=""
MODE=full
DOTFILES_NO_HINTS="${DOTFILES_NO_HINTS:-0}"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --profile)
            PROFILE="${2:-}"
            shift
            ;;
        --profile=*) PROFILE="${1#--profile=}" ;;
        --links-only) MODE=links ;;
        --dry-run) MODE=dry ;;
        --no-hints) DOTFILES_NO_HINTS=1 ;;
        -h | --help)
            sed -n '3,25p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "install: unknown argument '$1' (see --help)" >&2
            exit 2
            ;;
    esac
    shift
done
export DOTFILES_NO_HINTS

# ── XDG and tool locations (the same values .zshenv sets) ─────────────────────
export XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$HOME/.xdg}"
export XDG_PROJECTS_DIR="${XDG_PROJECTS_DIR:-$HOME/Projects}"

# ── Profile ───────────────────────────────────────────────────────────────────
LINKED="$XDG_CONFIG_HOME/dotfiles/resolved.json"
if [[ -z "$PROFILE" && -L "$LINKED" ]]; then
    PROFILE="$(basename "$(dirname "$(readlink "$LINKED")")")"
fi
if [[ -z "$PROFILE" ]]; then
    known="$(for d in generated/*/; do basename "$d"; done | tr '\n' '|')"
    echo "install: no profile. First run: ./bootstrap --profile <${known%|}>" >&2
    exit 2
fi
GEN="generated/$PROFILE"
if [[ ! -f "$GEN/dotbot.json" ]]; then
    echo "install: unknown profile '$PROFILE' (no $GEN/dotbot.json)" >&2
    exit 2
fi

# Profile values (REPOS_DIR, NOTES_DIR, ZK_NOTEBOOK_DIR) for the setup steps.
# shellcheck source=generated/home/env.sh
source "$GEN/env.sh"

FAILURES=()
fail() { FAILURES+=("$*"); }

# ── 1. dotbot (submodule over HTTPS) ──────────────────────────────────────────
DOTBOT="submods/core/dotbot/bin/dotbot"
if [[ ! -x "$DOTBOT" ]]; then
    git submodule update --init submods/core/dotbot
fi
dotbot() { "$DOTBOT" -d "$BASEDIR" -c "$GEN/dotbot.json" "$@"; }

if [[ "$MODE" == dry ]]; then
    step_outer 1 3 🔗 "Links ($PROFILE, dry run)"
    dotbot --dry-run --only create clean link
    step_outer 2 3 🍺 "Packages that would install, by module"
    awk '/^# module: /{m=$3} /^(brew|cask) /{n[m]++} END{for (k in n) printf "  ├─ %s: %d\n", k, n[k]}' "$GEN/Brewfile" | sort
    step_outer 3 3 🔧 "Setup steps that would run, in order"
    python3 -c 'import json,sys; [print("  ├─ " + s["description"]) for d in json.load(open(sys.argv[1])) if "shell" in d for s in d["shell"]]' "$GEN/dotbot.json"
    exit 0
fi

TOTAL=3
[[ "$MODE" == links ]] && TOTAL=1

step_outer 1 "$TOTAL" 🔗 "Linking configs ($PROFILE)"
dotbot --only create clean link || fail "links"
if [[ "$MODE" == links ]]; then
    if [[ ${#FAILURES[@]} -gt 0 ]]; then
        echo "❌ install --links-only failed: ${FAILURES[*]}" >&2
        exit 1
    fi
    step_done 🔗 "Links in place for $PROFILE"
    exit 0
fi

# ── sudo: one shared keep-alive for casks and macOS settings ──────────────────
if sudo -n true 2>/dev/null || sudo -v; then
    while true; do
        sudo -n true
        sleep 50
        kill -0 "$$" || exit
    done 2>/dev/null &
else
    echo "⚠️  No sudo: steps that need it will fail and be listed at the end." >&2
fi

# ── 2. Homebrew packages, one module at a time ────────────────────────────────
if ! command -v brew >/dev/null 2>&1; then
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [[ -x "$b" ]] && eval "$("$b" shellenv)" && break
    done
fi
if ! command -v brew >/dev/null 2>&1; then
    fail "Homebrew is not installed (run ./bootstrap)"
else
    export HOMEBREW_NO_ENV_HINTS=1
    step_outer 2 "$TOTAL" 🍺 "Installing packages by module"
    taps="$(grep -E '^tap ' "$GEN/Brewfile" || true)"
    modules="$(sed -n 's/^# module: //p' "$GEN/Brewfile")"
    # core first, then the rest in Brewfile order
    modules="$(printf '%s\n' "$modules" | grep -x core || true; printf '%s\n' "$modules" | grep -vx core || true)"
    n_mod=$(printf '%s\n' "$modules" | grep -c . || true)
    i=0
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-install.XXXXXX")"
    trap 'rm -rf "$tmp"' EXIT
    for mod in $modules; do
        i=$((i + 1))
        lines="$(awk -v m="$mod" '/^# module: /{cur=$3; next} cur==m && /^(brew|cask) /' "$GEN/Brewfile")"
        step_inner "$i" "$n_mod" "$mod ($(printf '%s\n' "$lines" | grep -c .) packages)"
        printf '%s\n%s\n' "$taps" "$lines" >"$tmp/$mod.Brewfile"
        if ! brew bundle install --file="$tmp/$mod.Brewfile"; then
            echo "  ↳ module $mod failed; retrying one package at a time"
            while IFS= read -r line; do
                kind="${line%% *}"
                pkg="$(printf '%s' "$line" | sed -E 's/^[a-z]+ "([^"]+)".*/\1/')"
                if [[ "$kind" == cask ]]; then
                    brew install --cask "$pkg" || fail "cask $pkg"
                else
                    brew install "$pkg" || fail "brew $pkg"
                fi
            done <<<"$lines"
        fi
    done
    step_done 🍺 "Packages done"
fi

# ── 3. Setup steps and services, in dependency order ──────────────────────────
step_outer 3 "$TOTAL" 🔧 "Running setup steps"
# Import the shell environment .zshenv builds (XDG relocations, profile env),
# so setup steps see what an interactive shell sees.
if command -v zsh >/dev/null 2>&1; then
    while IFS= read -r -d '' kv; do
        case "${kv%%=*}" in PWD | OLDPWD | SHLVL | _) continue ;; esac
        export "${kv?}"
    done < <(zsh -f -c 'source "$1" >/dev/null 2>&1; env -0' _ "$BASEDIR/config/zsh/.zshenv" 2>/dev/null || true)
fi
dotbot --only shell || fail "one or more setup steps (see the dotbot output above)"

# ── Summary ───────────────────────────────────────────────────────────────────
if [[ "$DOTFILES_NO_HINTS" != 1 ]]; then
    ./scripts/setup/post-install-hints || true
fi
if [[ ${#FAILURES[@]} -gt 0 ]]; then
    printf '\n❌ install finished with %d problem(s):\n' "${#FAILURES[@]}"
    printf '   - %s\n' "${FAILURES[@]}"
    exit 1
fi
step_done 🎉 "install complete ($PROFILE)"
