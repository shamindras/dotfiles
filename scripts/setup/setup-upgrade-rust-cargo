#!/usr/bin/env bash
#
# setup-upgrade-rust-cargo — rust toolchain via Homebrew's rustup.
#
# rustup comes from Homebrew (the `rust` unit; keg-only, so its bin folder is
# $(brew --prefix)/opt/rustup/bin). Toolchains live under $RUSTUP_HOME and
# cargo-installed tools under $CARGO_HOME (XDG paths, set in .zshenv). No
# curl | sh installer, and nothing sources ~/.cargo/env (field report #9).
# Skips with a reason when rustup is not installed. Idempotent.

set -Eeuo pipefail

export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export CARGO_HOME="${CARGO_HOME:-$XDG_DATA_HOME/cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-$XDG_DATA_HOME/rustup}"

if ! command -v rustup >/dev/null 2>&1; then
    for d in /opt/homebrew/opt/rustup/bin /usr/local/opt/rustup/bin; do
        [[ -x "$d/rustup" ]] && PATH="$d:$PATH" && break
    done
fi
if ! command -v rustup >/dev/null 2>&1; then
    echo "skip rust: rustup is not installed (brew install rustup)"
    exit 0
fi

if rustup default >/dev/null 2>&1 && rustup toolchain list | grep -q stable; then
    echo "Updating the stable toolchain..."
    rustup update stable --no-self-update
else
    echo "Installing the stable toolchain..."
    rustup default stable
fi
echo "✓ $(rustc --version) / $(cargo --version)"
