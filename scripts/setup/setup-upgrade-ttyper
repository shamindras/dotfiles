#!/usr/bin/env bash
#
# setup-upgrade-ttyper — install or upgrade ttyper with cargo (the only
# cargo-installed tool). Skips with a reason when cargo is missing.
# `cargo install` is a no-op when the latest version is already installed.

set -Eeuo pipefail

export CARGO_HOME="${CARGO_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/cargo}"
for d in /opt/homebrew/opt/rustup/bin /usr/local/opt/rustup/bin "$CARGO_HOME/bin"; do
    [[ -d "$d" ]] && PATH="$d:$PATH"
done

if ! command -v cargo >/dev/null 2>&1; then
    echo "skip ttyper: cargo is not installed (the rust unit provides it)"
    exit 0
fi
cargo install --locked ttyper
echo "✓ $(ttyper --version 2>/dev/null || echo ttyper installed)"
