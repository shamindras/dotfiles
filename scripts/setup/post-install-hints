#!/usr/bin/env bash

# Print manual post-install hints for tools that can't be fully automated.
# Suppressed when DOTFILES_NO_HINTS=1.

[[ "${DOTFILES_NO_HINTS:-0}" == "1" ]] && exit 0

printf "\n"
printf "📋 Manual post-install steps\n"
printf "   ─────────────────────────\n"
printf "\n"
printf "   🦊 Firefox\n"
printf "      Some extensions need manual setup after Firefox Sync.\n"
printf "      📖 See: config/firefox/post-install-checklist.md\n"
printf "\n"
printf "   🔨 Hammerspoon\n"
printf "      1. System Settings → Privacy & Security → Accessibility\n"
printf "      2. Enable Hammerspoon (the grant is sticky across upgrades)\n"
printf "      3. Home address for the maps leader leaf (kept out of git):\n"
printf "         hs -c \"hs.settings.set('home_address', '<street address>')\" && hs -c \"hs.reload()\"\n"
printf "      (MJConfigFile defaults write + hidutil LaunchAgent handled by setup-hammerspoon)\n"
printf "\n"
printf "   🔑 GitHub (once per Mac, by hand)\n"
printf "      1. gh auth login --web\n"
printf "      2. gh auth refresh -h github.com -s admin:public_key,admin:ssh_signing_key\n"
printf "      3. scripts/setup/setup-github-auth          # SSH key for push and signing\n"
printf "      Work Mac: scripts/setup/setup-github-auth --email you@xero.com\n"
helper_on="$(plutil -extract settings.git_gh_credential_helper raw -o - "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/resolved.json" 2>/dev/null || echo unset)"
if [[ "$helper_on" == false ]]; then
    printf "      This profile has no git credential helper for github.com: HTTPS pushes need\n"
    printf "      gh auth login plus git_gh_credential_helper set to true in manifest.json, or Xero's own method.\n"
fi
printf "\n"
printf "   🛟 SSH-from-phone (home: Remote Login is on)\n"
printf "      1. Find this Mac's LAN IP: System Settings → Wi-Fi → Details… (or 'ipconfig getifaddr en0')\n"
printf "      2. From your phone, confirm: ssh %s@<ip>\n" "$(id -un)"
printf "      If the keyboard ever wedges: ssh in from the phone and run pkill -x Hammerspoon\n"
printf "\n"
printf "   🚀 Raycast\n"
printf "      1. Open Raycast and sign in\n"
printf "      2. Run: just raycast_import\n"
printf "      3. Enter export passphrase (🔐 see password manager)\n"
printf "      4. Reinstall Store extensions + re-auth OAuth tokens\n"
printf "      📖 See: config/raycast/CLAUDE.md\n"
printf "\n"
if [[ -d /Applications/Dropbox.app ]]; then
    printf "   📦 Dropbox (pin files local)\n"
    printf "      Fresh installs default new files to online-only placeholders\n"
    printf "      (stat flag UF_DATALESS 0x40000000). PDFs/large binaries fail\n"
    printf "      to open with 'Operation timed out' until materialized.\n"
    printf "      If the Finder right-click submenu (Make available offline /\n"
    printf "      Sync & storage) is MISSING, Dropbox's appex extensions failed\n"
    printf "      to register because cask install left xattrs on the bundle.\n"
    printf "      Diagnose & fix:\n"
    printf "         codesign --verify --strict /Applications/Dropbox.app/Contents/PlugIns/*.appex\n"
    printf "         # 'detritus not allowed' → strip xattrs and re-register:\n"
    printf "         sudo xattr -cr /Applications/Dropbox.app\n"
    printf "         pluginkit -a /Applications/Dropbox.app && killall Finder\n"
    printf "      Then in Finder:\n"
    printf "      1. Right-click ~/Dropbox → 'Make available offline' (one\n"
    printf "         action, pins everything recursively)\n"
    printf "      2. Dropbox menu bar → avatar → Preferences → Sync → set\n"
    printf "         'Default location for new files' to Local\n"
    printf "      3. Verify: stat -f '%%Xf' <some-pdf> → no 0x40000000 bit\n"
    printf "\n"
    printf "      Then finish the ~/Dropbox link and the notes: just dropbox_finish\n\n"
fi
