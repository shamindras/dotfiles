#!/usr/bin/env bash
set -Eeuo pipefail

# Install missing + update outdated treesitter parsers (default), or show
# parser status (--status).  Reads the parser list from treesitter.lua
# (single source of truth).  Installs and updates run in one headless nvim
# each, with nvim-treesitter's synchronous API (`:wait()`), so nvim exits as
# soon as the work is done; no concurrent nvim starts race on the parser dir
# (e.g., sesh-reset --common).
#
# On a fresh machine nvim-treesitter is not there yet: one headless start
# first installs the plugins at their config/nvim/lazy-lock.json commits,
# leaving the lockfile unchanged. If the plugin still cannot load, the
# script skips once with the reason instead of waiting.
#
# Values are read from nvim's stdout only on lines tagged `TSDATA`, because
# a first headless start also prints lazy.nvim's install log there.
#
# Usage:
#   ./scripts/ops/setup-nvim-treesitter           # install missing + update outdated
#   ./scripts/ops/setup-nvim-treesitter --status   # show parser status table (read-only)
#
# Requires: nvim
# Requires for install/update: tree-sitter-cli (brew install tree-sitter-cli)

MODE="install"
if [[ "${1:-}" == "--status" ]]; then
  MODE="status"
fi

command -v nvim &>/dev/null || { echo "[SKIP] nvim not found"; exit 0; }

# ── Plugins ─────────────────────────────────────────────────────────────
# nvim_data <lua expression>: print the value, tagged, and keep only that line.
nvim_data() {
  nvim --headless +"lua io.write('TSDATA ' .. tostring($1) .. '\\n')" +'qa' 2>/dev/null |
    tr -d '\r' | sed -n 's/^TSDATA //p'
}

has_ts() { [[ "$(nvim_data "pcall(require, 'nvim-treesitter.config')")" == "true" ]]; }

# First run on this machine (no plugins yet): one headless start installs
# them at their lazy-lock.json commits (lazy-bootstrap.lua pins lazy.nvim
# itself), under its own time limit.
LAZY_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy"
if [[ "$MODE" == "install" && ! -d "$LAZY_DIR/nvim-treesitter" ]]; then
  echo "  ⬇️  nvim plugins: installing from lazy-lock.json..."
  perl -e 'alarm shift @ARGV; exec @ARGV' 600 nvim --headless +qa >/dev/null 2>&1 || true
fi
if ! has_ts; then
  echo "[SKIP] nvim-treesitter cannot be loaded (plugins not installed): parsers install on the next nvim start"
  exit 0
fi

# ── Parser directory ────────────────────────────────────────────────────
PARSER_DIR="$(nvim_data 'require("nvim-treesitter.config").get_install_dir("parser")')"

if [[ -z "$PARSER_DIR" || ! "$PARSER_DIR" == /* ]]; then
  echo "[ERROR] Could not determine parser install dir"
  exit 1
fi

# ── Gather revision data via a single headless nvim call ────────────────
# Output: one line per parser: <lang> <installed_rev|MISSING> <wanted_rev>
REVISION_DATA="$(nvim --headless +'lua
  local specs = dofile(vim.fn.stdpath("config") .. "/lua/shamindras/plugins/treesitter.lua")
  local parsers_mod = require("nvim-treesitter.parsers")
  local info_dir = vim.fn.expand("~/.local/share/nvim/site/parser-info")
  local parser_dir = require("nvim-treesitter.config").get_install_dir("parser")
  local langs = {}
  for _, s in ipairs(specs) do
    if s.opts and s.opts.ensure_installed then
      for _, p in ipairs(s.opts.ensure_installed) do
        langs[#langs + 1] = p
      end
    end
  end
  for _, lang in ipairs(langs) do
    local wanted = "UNKNOWN"
    local pinfo = parsers_mod[lang]
    if pinfo and pinfo.install_info and pinfo.install_info.revision then
      wanted = pinfo.install_info.revision
    end
    local installed = "MISSING"
    local so_path = parser_dir .. "/" .. lang .. ".so"
    local so_file = io.open(so_path, "r")
    if so_file then
      so_file:close()
      local rev_path = info_dir .. "/" .. lang .. ".revision"
      local rev_file = io.open(rev_path, "r")
      if rev_file then
        installed = rev_file:read("*a"):gsub("%s+$", "")
        rev_file:close()
      else
        installed = "NO_REV"
      end
    end
    io.write("TSDATA " .. lang .. " " .. installed .. " " .. wanted .. "\n")
  end
' +'qa' 2>/dev/null | tr -d '\r' | sed -n 's/^TSDATA //p')"

if [[ -z "$REVISION_DATA" ]]; then
  echo "No parsers in ensure_installed — nothing to do"
  exit 0
fi

# Parse into arrays
declare -a LANGS=() INSTALLED_REVS=() WANTED_REVS=()
while IFS=' ' read -r lang inst want; do
  LANGS+=("$lang")
  INSTALLED_REVS+=("$inst")
  WANTED_REVS+=("$want")
done <<< "$REVISION_DATA"

TOTAL=${#LANGS[@]}

# ── STATUS mode ─────────────────────────────────────────────────────────
# Helper: print a row with fixed-width columns using tabs for alignment.
# Emoji characters confuse printf %-Ns (byte vs display width), so we
# build each status string to a fixed display width manually.
print_row() {
  printf "  %-18s %-24s %-12s %-12s %-10s %s\n" "$1" "$2" "$3" "$4" "$5" "$6"
}

if [[ "$MODE" == "status" ]]; then
  printf "\n🌳 Treesitter Parser Status\n"
  printf "  ═════════════════════════════════════════════════════════════════════════════════════\n"
  print_row "Parser" "Status" "Installed" "Wanted" "Size" "Modified"
  print_row "----------------" "----------------------" "----------" "----------" "--------" "----------"

  count_ok=0 count_update=0 count_missing=0

  for i in "${!LANGS[@]}"; do
    lang="${LANGS[$i]}"
    inst="${INSTALLED_REVS[$i]}"
    want="${WANTED_REVS[$i]}"

    if [[ "$inst" == "MISSING" ]]; then
      # ❌ is 1 emoji (2 display cols) + space + "missing" (7) = 10 display cols
      # Pad to ~20 display cols with trailing spaces
      status="❌ missing          "
      inst_display="—"
      size_display="—"
      mod_display="—"
      count_missing=$((count_missing + 1))
    else
      so_path="${PARSER_DIR}/${lang}.so"
      # File size (human-readable)
      size_bytes=$(stat -f %z "$so_path" 2>/dev/null || echo 0)
      if (( size_bytes >= 1048576 )); then
        size_display="$(awk "BEGIN {printf \"%.1f MB\", $size_bytes/1048576}")"
      else
        size_display="$(awk "BEGIN {printf \"%.0f KB\", $size_bytes/1024}")"
      fi
      # Modified date
      mod_epoch=$(stat -f %m "$so_path" 2>/dev/null || echo 0)
      mod_display=$(date -r "$mod_epoch" "+%Y-%m-%d" 2>/dev/null || echo "—")

      if [[ "$inst" == "$want" ]]; then
        # ✅ is 1 emoji (2 display cols) + space + "up to date" (10) = 13 display cols
        status="✅ up to date       "
        count_ok=$((count_ok + 1))
      else
        # ⚠️ is 1 emoji (2 display cols) + space + "update available" (16) = 19 display cols
        status="⚠️  update available "
        count_update=$((count_update + 1))
      fi
      inst_display="${inst:0:8}"
    fi

    want_display="${want:0:8}"
    [[ "$want" == "UNKNOWN" ]] && want_display="—"

    printf "  %-18s %s %-12s %-12s %-10s %s\n" \
      "$lang" "$status" "$inst_display" "$want_display" "$size_display" "$mod_display"
  done

  printf "  ═════════════════════════════════════════════════════════════════════════════════════\n"
  parser_list=$(printf "%s" "${LANGS[*]}" | tr ' ' ', ')
  printf "  ensure_installed (%d): %s\n" "$TOTAL" "$parser_list"
  printf "\n  📊 Summary: %d up to date, %d update available, %d missing\n\n" \
    "$count_ok" "$count_update" "$count_missing"
  exit 0
fi

# ── INSTALL + UPDATE mode (default) ────────────────────────────────────
command -v tree-sitter &>/dev/null || { echo "[SKIP] tree-sitter CLI not found (brew install tree-sitter-cli)"; exit 0; }

declare -a MISSING=() OUTDATED=()
count_skipped=0
for i in "${!LANGS[@]}"; do
  if [[ "${INSTALLED_REVS[$i]}" == "MISSING" ]]; then
    MISSING+=("${LANGS[$i]}")
  elif [[ "${INSTALLED_REVS[$i]}" != "${WANTED_REVS[$i]}" ]]; then
    OUTDATED+=("${LANGS[$i]}")
  else
    count_skipped=$((count_skipped + 1))
  fi
done

printf "\n🌳 Treesitter parsers: %d missing, %d outdated, %d up to date\n" \
  "${#MISSING[@]}" "${#OUTDATED[@]}" "$count_skipped"
printf "═══════════════════════════════════════════════════\n"

# lua_list a b c -> 'a','b','c'
lua_list() { printf "'%s'," "$@" | sed 's/,$//'; }

# run_ts <install|update> <langs...>: one headless nvim, exits when done.
run_ts() {
  local action="$1"; shift
  local start=$SECONDS
  nvim --headless \
    +"lua require('nvim-treesitter').${action}({$(lua_list "$@")}):wait(900000)" \
    +'qa' >/dev/null 2>&1 || true
  printf "  ⏱  %s of %d parser(s) took %ds\n" "$action" "$#" "$((SECONDS - start))"
}

count_installed=0 count_updated=0 count_failed=0
if [[ ${#MISSING[@]} -gt 0 ]]; then
  printf "  ⬇️  installing: %s\n" "${MISSING[*]}"
  run_ts install "${MISSING[@]}"
  for lang in "${MISSING[@]}"; do
    if [[ -f "${PARSER_DIR}/${lang}.so" ]]; then
      printf "  ✅ %s: installed\n" "$lang"
      count_installed=$((count_installed + 1))
    else
      printf "  ❌ %s: not installed\n" "$lang"
      count_failed=$((count_failed + 1))
    fi
  done
fi
if [[ ${#OUTDATED[@]} -gt 0 ]]; then
  printf "  🔄 updating: %s\n" "${OUTDATED[*]}"
  run_ts update "${OUTDATED[@]}"
  for lang in "${OUTDATED[@]}"; do
    printf "  ✅ %s: updated\n" "$lang"
    count_updated=$((count_updated + 1))
  done
fi

# ── Cache cleanup ───────────────────────────────────────────────────────
CACHE_DIR="${HOME}/.cache/nvim"
find "$CACHE_DIR" -maxdepth 1 -name 'tree-sitter-*-tmp' -type d \
  -exec rm -rf {} + 2>/dev/null || true
find "$CACHE_DIR" -maxdepth 1 -name 'tree-sitter-*' -type d \
  -exec rm -rf {} + 2>/dev/null || true
find "$CACHE_DIR" -maxdepth 1 -name 'tree-sitter-*.tar.gz' -type f \
  -exec rm -f {} + 2>/dev/null || true

printf "\n✅ Summary: %d installed, %d updated, %d up to date, %d failed\n\n" \
  "$count_installed" "$count_updated" "$count_skipped" "$count_failed"
# A parser that did not build is reported, not fatal: nvim works without it.
