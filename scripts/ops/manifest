#!/usr/bin/env python3
"""manifest — resolve manifest.json into per-profile output under generated/.

Usage:
  manifest render [--check]            write generated/<profile>/* and generated/compare.md
                                       (--check: compare instead of write; exit 1 on drift)
  manifest check                       schema + semantic checks + render --check
  manifest set <profile> <unit> <state>
                                       set a per-profile override (managed|external|off|default)
  manifest why <profile> <unit>        explain a unit's state in a profile
  manifest diff                        print the home-versus-work comparison

Runs at edit time and in CI only. A fresh Mac bootstraps from the committed
generated/ files and never needs this script. Python 3.9+ stdlib only.

Model (see manifest.schema.json):
  - units are tools with config, setup, a service, requires or an app block;
  - module package lists hold plain packages; each becomes an implicit unit
    named after the package (last path segment for tap packages);
  - a profile turns modules on and overrides single units: managed, external
    (on the Mac but installed by someone else: no package, no setup) or off;
  - requires pulls a unit in, unless the profile turned it off explicitly,
    which is an error naming both units; cycles (mutual pairs) are fine.
"""

import json
import os
import re
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
MANIFEST = os.path.join(REPO, "manifest.json")
SCHEMA = os.path.join(REPO, "scripts", "ops", "manifest.schema.json")
GENERATED = os.path.join(REPO, "generated")
STATES = ("managed", "external", "off")
UNIT_KEYS = [
    "module",
    "note",
    "brew",
    "cask",
    "links",
    "create",
    "setup",
    "service",
    "requires",
    "app",
]
HEADER = "Generated by scripts/ops/manifest render from manifest.json. Do not edit."
XDG_CREATE = [
    "${XDG_BIN_HOME}",
    "${XDG_CONFIG_HOME}",
    "${XDG_CACHE_HOME}",
    "${XDG_DATA_HOME}",
    "${XDG_STATE_HOME}",
    "${XDG_RUNTIME_DIR}",
    "${XDG_PROJECTS_DIR}",
]


class ManifestError(Exception):
    pass


# ── Schema validation (the subset of JSON Schema the committed schema uses) ──


def validate(value, schema, root=None, path="$"):
    """Return a list of "path: problem" strings."""
    root = root if root is not None else schema
    if "$ref" in schema:
        ref = schema["$ref"]
        if not ref.startswith("#/$defs/"):
            return ["%s: unsupported $ref %s" % (path, ref)]
        return validate(value, root["$defs"][ref[len("#/$defs/"):]], root, path)
    errs = []
    types = {
        "object": dict,
        "array": list,
        "string": str,
        "boolean": bool,
        "integer": int,
    }
    t = schema.get("type")
    if t:
        ok = isinstance(value, types[t])
        if t == "integer" and isinstance(value, bool):
            ok = False
        if not ok:
            return ["%s: expected %s" % (path, t)]
    if "enum" in schema and value not in schema["enum"]:
        errs.append("%s: %r is not one of %s" % (path, value, schema["enum"]))
    if "pattern" in schema and isinstance(value, str) and not re.search(schema["pattern"], value):
        errs.append("%s: %r does not match %s" % (path, value, schema["pattern"]))
    if isinstance(value, dict):
        props = schema.get("properties", {})
        pats = schema.get("patternProperties", {})
        for req in schema.get("required", []):
            if req not in value:
                errs.append("%s: missing required key %r" % (path, req))
        for k, v in value.items():
            sub = path + "." + k
            if k in props:
                errs += validate(v, props[k], root, sub)
                continue
            matched = [s for p, s in pats.items() if re.search(p, k)]
            for s in matched:
                errs += validate(v, s, root, sub)
            if matched:
                continue
            extra = schema.get("additionalProperties", True)
            if extra is False:
                errs.append("%s: unknown key %r" % (path, k))
            elif isinstance(extra, dict):
                errs += validate(v, extra, root, sub)
    if isinstance(value, list):
        if schema.get("uniqueItems"):
            seen = []
            for item in value:
                if item in seen:
                    errs.append("%s: duplicate item %r" % (path, item))
                seen.append(item)
        if "items" in schema:
            for i, item in enumerate(value):
                errs += validate(item, schema["items"], root, "%s[%d]" % (path, i))
    return errs


# ── Model ──


def short(pkg):
    """Unit name for a package: last path segment (tap packages)."""
    return pkg.rsplit("/", 1)[-1]


def all_units(m):
    """Explicit units plus one implicit unit per module package: name -> unit."""
    units = {}
    for mod, spec in sorted(m.get("modules", {}).items()):
        for kind in ("brew", "cask"):
            for pkg in spec.get(kind, []):
                units[short(pkg)] = {"module": mod, kind: [pkg], "_implicit": True}
    for name, u in m.get("units", {}).items():
        units[name] = u
    return units


def semantic_errors(m, root=REPO, check_files=True):
    errs = []
    units = m.get("units", {})
    modules = m.get("modules", {})
    owners = {}

    def own(pkg, who):
        if pkg in owners:
            errs.append("package %s is declared twice: %s and %s" % (pkg, owners[pkg], who))
        owners[pkg] = who
        if pkg.count("/") == 2 and pkg.rsplit("/", 1)[0] not in m.get("taps", {}):
            errs.append("%s: tap %s is not declared in taps" % (who, pkg.rsplit("/", 1)[0]))

    for mod, spec in sorted(modules.items()):
        for kind in ("brew", "cask"):
            for pkg in spec.get(kind, []):
                own(pkg, "module " + mod)
                if short(pkg) in units:
                    errs.append("package %s in module %s clashes with unit %s" % (pkg, mod, short(pkg)))
    names = set(all_units(m))
    dests = {}
    for name, u in sorted(units.items()):
        if u["module"] not in modules:
            errs.append("unit %s: unknown module %s" % (name, u["module"]))
        for kind in ("brew", "cask"):
            for pkg in u.get(kind, []):
                own(pkg, "unit " + name)
        for r in u.get("requires", []):
            if r not in names:
                errs.append("unit %s requires unknown unit %s" % (name, r))
            if r == name:
                errs.append("unit %s requires itself" % name)
        for dest, src in u.get("links", {}).items():
            if dest in dests:
                errs.append("link %s is claimed by %s and %s" % (dest, dests[dest], name))
            dests[dest] = name
            if check_files and not src.startswith("${") and not os.path.lexists(os.path.join(root, src)):
                errs.append("unit %s: link source %s does not exist" % (name, src))
    for pname, p in sorted(m.get("profiles", {}).items()):
        for mod in p.get("modules", []):
            if mod not in modules:
                errs.append("profile %s: unknown module %s" % (pname, mod))
        for u in p.get("units", {}):
            if u not in names:
                errs.append("profile %s: override for unknown unit %s" % (pname, u))
        for role, u in p.get("roles", {}).items():
            if u not in units or "app" not in units[u]:
                errs.append("profile %s: role %s names %s, which is not a unit with an app block" % (pname, role, u))
    return errs


def resolve(m, profile):
    """Return (states, reasons, order, errors) for one profile."""
    p = m["profiles"][profile]
    units = all_units(m)
    overrides = p.get("units", {})
    on_modules = set(p.get("modules", []))
    states, reasons, errs = {}, {}, []
    for name, u in units.items():
        if name in overrides:
            states[name] = overrides[name]
            reasons[name] = "set in profile %s" % profile
        elif u["module"] in on_modules:
            states[name] = "managed"
            reasons[name] = "module %s is on" % u["module"]
        else:
            states[name] = "off"
            reasons[name] = "module %s is off" % u["module"]
    queue = sorted(n for n, s in states.items() if s != "off")
    while queue:
        name = queue.pop(0)
        for r in units[name].get("requires", []):
            if r not in states or states[r] != "off":
                continue
            if overrides.get(r) == "off":
                errs.append("profile %s: %s requires %s, but %s is off" % (profile, name, r, r))
                continue
            states[r] = "managed"
            reasons[r] = "required by %s" % name
            queue.append(r)
    for role, u in p.get("roles", {}).items():
        if states.get(u, "off") == "off":
            errs.append("profile %s: role %s names %s, which is off" % (profile, role, u))
    on = sorted(n for n, s in states.items() if s != "off")
    leaders = {}
    for n in on:
        key = units[n].get("app", {}).get("leader")
        if key:
            if key in leaders:
                errs.append("profile %s: leader key %s is used by %s and %s" % (profile, key, leaders[key], n))
            leaders[key] = n
    return states, reasons, topo_order(units, on), errs


def topo_order(units, on):
    """Dependencies first. Mutual pairs (cycles) form one group, ordered by name."""
    onset = set(on)
    graph = {n: sorted(r for r in units[n].get("requires", []) if r in onset) for n in on}
    index, low, stack, onstack, sccs = {}, {}, [], set(), []
    counter = [0]

    def strong(v):
        index[v] = low[v] = counter[0]
        counter[0] += 1
        stack.append(v)
        onstack.add(v)
        for w in graph[v]:
            if w not in index:
                strong(w)
                low[v] = min(low[v], low[w])
            elif w in onstack:
                low[v] = min(low[v], index[w])
        if low[v] == index[v]:
            comp = []
            while True:
                w = stack.pop()
                onstack.discard(w)
                comp.append(w)
                if w == v:
                    break
            sccs.append(sorted(comp))

    for v in on:
        if v not in index:
            strong(v)
    # Tarjan emits components in reverse topological order of the "requires"
    # edges, i.e. dependencies first.
    return [n for comp in sccs for n in comp]


# ── Rendering ──


def shell_step(unit, step):
    cmd = step["command"]
    needs = step.get("needs", [])
    if needs:
        test = " && ".join("command -v %s >/dev/null 2>&1" % n for n in needs)
        cmd = 'if %s; then %s; else echo "skip %s: needs %s"; fi' % (test, cmd, unit, " ".join(needs))
    out = {"command": cmd, "description": "%s: %s" % (unit, step["description"])}
    if step.get("stdin"):
        out["stdin"] = True
    return out


def render_profile(m, profile):
    states, reasons, order, errs = resolve(m, profile)
    if errs:
        raise ManifestError("\n".join(errs))
    units = all_units(m)
    p = m["profiles"][profile]
    managed = [n for n in order if states[n] == "managed"]
    on = [n for n in order if states[n] != "off"]

    # Brewfile: taps in use, then packages grouped by module.
    pkgs = {"brew": {}, "cask": {}}
    for n in managed:
        u = units[n]
        for kind in ("brew", "cask"):
            for pkg in u.get(kind, []):
                pkgs[kind].setdefault(u["module"], []).append(pkg)
    taps = sorted({pkg.rsplit("/", 1)[0] for k in pkgs for ps in pkgs[k].values() for pkg in ps if pkg.count("/") == 2})
    lines = ["# %s" % HEADER, "# Profile: %s" % profile, ""]
    for t in taps:
        trusted = m["taps"][t].get("trusted")
        lines.append('tap "%s"%s' % (t, ", trusted: true" if trusted else ""))
    for mod in sorted(set(pkgs["brew"]) | set(pkgs["cask"])):
        lines += ["", "# module: %s" % mod]
        lines += ['brew "%s"' % x for x in sorted(pkgs["brew"].get(mod, []))]
        lines += ['cask "%s"' % x for x in sorted(pkgs["cask"].get(mod, []))]
    brewfile = "\n".join(lines) + "\n"

    # dotbot config: create, clean, links, then setup steps in dependency order.
    create = list(XDG_CREATE)
    links = {}
    steps = []
    for n in on:
        u = units[n]
        create += [c for c in u.get("create", []) if c not in create]
        links.update(u.get("links", {}))
        if states[n] == "managed":
            steps += [shell_step(n, s) for s in u.get("setup", [])]
            if u.get("service"):
                steps.append(
                    shell_step(
                        n,
                        {
                            "command": "brew services restart %s" % u["service"],
                            "description": "restart the %s service" % u["service"],
                            "needs": ["brew"],
                        },
                    )
                )
    dotbot = [
        {
            "defaults": {
                "link": {"create": True, "relink": True},
                "shell": {"stdin": False, "stdout": True, "stderr": True},
            }
        },
        {"create": create},
        {"clean": {"~/": {"force": True}, "~/.config": {"force": True}}},
        {"link": dict(sorted(links.items()))},
    ]
    if steps:
        dotbot.append({"shell": steps})

    resolved = {
        "generated_by": HEADER,
        "profile": profile,
        "roles": p.get("roles", {}),
        "settings": p["settings"],
        "order": on,
        "units": {},
    }
    for n in sorted(on):
        entry = {"state": states[n], "module": units[n]["module"], "reason": reasons[n]}
        if "app" in units[n]:
            entry["app"] = units[n]["app"]
        resolved["units"][n] = entry

    s = p["settings"]
    env = ["export REPOS_DIR=\"%s\"" % s["repos_dir"], "export NOTES_DIR=\"%s\"" % s["notes_dir"]]
    env_sh = "# shellcheck shell=sh\n# %s\n# Profile: %s\n%s\n" % (HEADER, profile, "\n".join(env))
    env_zsh = "# %s\n# Profile: %s (zsh twin of env.sh)\n%s\n" % (HEADER, profile, "\n".join(env))

    return {
        "Brewfile": brewfile,
        "dotbot.json": json.dumps(dotbot, indent=2) + "\n",
        "resolved.json": json.dumps(resolved, indent=2) + "\n",
        "env.sh": env_sh,
        "env.zsh": env_zsh,
    }


def comparison(m):
    profiles = sorted(m["profiles"])
    states = {p: resolve(m, p)[0] for p in profiles}
    units = all_units(m)
    rows = []
    for n in sorted(units):
        vals = [states[p][n] for p in profiles]
        if len(set(vals)) > 1:
            rows.append([n, units[n]["module"]] + vals)
    counts = ["- **%s**: %d managed, %d external, %d off" % (
        p, *[sum(1 for v in states[p].values() if v == s) for s in STATES]) for p in profiles]
    widths = [max(len(str(r[i])) for r in [["Unit", "Module"] + profiles] + rows) for i in range(2 + len(profiles))]

    def row(cells):
        return "| " + " | ".join(str(c).ljust(widths[i]) for i, c in enumerate(cells)) + " |"

    table = [row(["Unit", "Module"] + profiles), "| " + " | ".join("-" * w for w in widths) + " |"]
    table += [row(r) for r in rows]
    return "\n".join(
        ["# Home versus work", "", "<!-- %s -->" % HEADER, ""] + counts + ["", "Units whose state differs:", ""] + table
    ) + "\n"


def render_all(m):
    out = {}
    for p in sorted(m["profiles"]):
        for fname, text in render_profile(m, p).items():
            out[os.path.join(p, fname)] = text
    out["compare.md"] = comparison(m)
    return out


# ── Commands ──


def load(path=MANIFEST):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        raise ManifestError("%s does not exist" % os.path.relpath(path, REPO))
    except ValueError as e:
        raise ManifestError("%s is not valid JSON: %s" % (os.path.relpath(path, REPO), e))


def all_errors(m, root=REPO, check_files=True):
    with open(SCHEMA) as f:
        schema = json.load(f)
    errs = validate(m, schema)
    if errs:
        return errs
    errs = semantic_errors(m, root, check_files)
    for p in sorted(m["profiles"]):
        errs += resolve(m, p)[3]
    return errs


def cmd_render(m, check):
    files = render_all(m)
    drift = []
    for rel, text in sorted(files.items()):
        path = os.path.join(GENERATED, rel)
        current = open(path).read() if os.path.exists(path) else None
        if current != text:
            drift.append(rel)
            if not check:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w") as f:
                    f.write(text)
    if os.path.isdir(GENERATED):
        for dirpath, _, fnames in os.walk(GENERATED):
            for fn in fnames:
                rel = os.path.relpath(os.path.join(dirpath, fn), GENERATED)
                if rel not in files:
                    drift.append(rel + " (stale)")
                    if not check:
                        os.remove(os.path.join(dirpath, fn))
    if check:
        if drift:
            print("generated/ is out of date: " + ", ".join(drift))
            print("run: just manifest_render")
            return 1
        print("generated/ matches manifest.json (%d files)" % len(files))
        return 0
    print("rendered %d files, %d changed" % (len(files), len(drift)))
    return 0


def canonical(m):
    """Fixed order: top-level keys, maps sorted by name, unit keys in schema order."""
    out = {"schema_version": m["schema_version"]}
    if "note" in m:
        out["note"] = m["note"]
    out["taps"] = dict(sorted(m["taps"].items()))
    out["modules"] = dict(sorted(m["modules"].items()))
    out["units"] = {
        n: {k: m["units"][n][k] for k in UNIT_KEYS if k in m["units"][n]} for n in sorted(m["units"])
    }
    out["profiles"] = {}
    for pn in sorted(m["profiles"]):
        p = m["profiles"][pn]
        q = {k: p[k] for k in ("note", "modules", "units", "roles", "settings") if k in p}
        if "units" in q:
            q["units"] = dict(sorted(q["units"].items()))
        out["profiles"][pn] = q
    return out


def write_manifest(m, path=MANIFEST):
    text = json.dumps(canonical(m), indent=2) + "\n"
    with open(path, "w") as f:
        f.write(text)
    prettier = subprocess.run(["sh", "-c", "command -v prettier"], capture_output=True, text=True).stdout.strip()
    if prettier:
        subprocess.run([prettier, "--write", path], capture_output=True)


def cmd_check(m):
    errs = all_errors(m)
    if not errs and json.dumps(canonical(m)) != json.dumps(m):
        errs.append("manifest.json is not in canonical order: maps sorted by name, unit keys in schema order"
                    " (manifest_set rewrites it canonically)")
    if errs:
        print("\n".join("error: " + e for e in errs))
        return 1
    print("manifest.json: schema and semantic checks pass for %s" % ", ".join(sorted(m["profiles"])))
    return cmd_render(m, check=True)


def cmd_set(m, profile, unit, state):
    if profile not in m["profiles"]:
        raise ManifestError("unknown profile %s" % profile)
    if unit not in all_units(m):
        raise ManifestError("unknown unit %s" % unit)
    if state not in STATES + ("default",):
        raise ManifestError("state must be one of managed, external, off, default")
    overrides = m["profiles"][profile].setdefault("units", {})
    if state == "default":
        overrides.pop(unit, None)
    else:
        overrides[unit] = state
    errs = all_errors(m)
    if errs:
        raise ManifestError("not saved:\n" + "\n".join(errs))
    write_manifest(m)
    print("%s: %s is now %s" % (profile, unit, resolve(m, profile)[0][unit]))
    return cmd_render(m, check=False)


def cmd_why(m, profile, unit):
    if profile not in m["profiles"]:
        raise ManifestError("unknown profile %s" % profile)
    units = all_units(m)
    if unit not in units:
        raise ManifestError("unknown unit %s" % unit)
    states, reasons, order, errs = resolve(m, profile)
    print("%s in %s: %s (%s)" % (unit, profile, states[unit], reasons[unit]))
    users = sorted(n for n in units if unit in units[n].get("requires", []) and states[n] != "off")
    if users:
        print("required by: " + ", ".join(users))
    needs = units[unit].get("requires", [])
    if needs:
        print("requires: " + ", ".join("%s (%s)" % (r, states.get(r, "?")) for r in needs))
    for e in errs:
        print("error: " + e)
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    try:
        m = load()
        if cmd == "render":
            errs = all_errors(m)
            if errs:
                raise ManifestError("\n".join(errs))
            return cmd_render(m, check="--check" in args)
        if cmd == "check":
            return cmd_check(m)
        if cmd == "set" and len(args) == 3:
            return cmd_set(m, *args)
        if cmd == "why" and len(args) == 2:
            return cmd_why(m, *args)
        if cmd == "diff":
            sys.stdout.write(comparison(m))
            return 0
        print(__doc__.strip(), file=sys.stderr)
        return 2
    except ManifestError as e:
        print("error: %s" % e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
