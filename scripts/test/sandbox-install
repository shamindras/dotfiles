#!/usr/bin/env bash
#
# sandbox-install — link-only install into a throwaway HOME, per profile, twice.
#
# For each profile (home from N5, work from N6):
#   - run `./install --links-only --profile <p>` with HOME set to a fresh
#     mktemp dir, then a second time
#   - assert: both runs exit 0, every link resolves, the second run leaves the
#     same set of links (idempotent)
#   - separately (N16, after the move to ~/repos): no link resolves into
#     CloudStorage
#
# SAFETY: ./install is only executed when its source declares --links-only
# and --profile (module E, node N5). Before that, ./install would run brew
# and macOS settings against the real machine, so it is never called; the
# test reports XFAIL with the node id instead. It is never skipped silently.

set -Eeuo pipefail

# shellcheck source=scripts/test/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

# CI runs one profile per matrix job via DOTFILES_TEST_PROFILES.
PROFILES="${DOTFILES_TEST_PROFILES:-home work}"

t_header "sandbox install"

install_supports_dry_run() {
    grep -q -- '--links-only' "$TEST_REPO/install" && grep -q -- '--profile' "$TEST_REPO/install"
}

# link_map <dir> — "<link> -> <resolved target>" for every symlink under dir.
link_map() {
    local dir=$1 l
    find "$dir" -type l | sort | while IFS= read -r l; do
        printf '%s -> %s\n' "${l#"$dir"}" "$(cd "$(dirname "$l")" && readlink "$l")"
    done
}

# run_profile <profile> — the whole check for one profile; non-zero on any problem.
run_profile() {
    local profile=$1 sandbox first second l dangling
    sandbox="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-sandbox-$profile.XXXXXX")"
    case "$sandbox" in /tmp/* | /var/folders/* | /private/* | "${TMPDIR:-/nonexistent}"*) ;; *)
        echo "refusing: sandbox $sandbox is not under a temp dir"
        return 1
        ;;
    esac
    (cd "$TEST_REPO" && env -u XDG_CONFIG_HOME -u XDG_DATA_HOME HOME="$sandbox" ./install --links-only --profile "$profile") || return 1
    first="$(link_map "$sandbox")"
    (cd "$TEST_REPO" && env -u XDG_CONFIG_HOME -u XDG_DATA_HOME HOME="$sandbox" ./install --links-only --profile "$profile") || return 1
    second="$(link_map "$sandbox")"
    [[ -n "$first" ]] || { echo "no links created" && return 1; }
    [[ "$first" == "$second" ]] || { echo "second run changed the links" && return 1; }
    dangling=""
    while IFS= read -r l; do
        [[ -e "$l" ]] || dangling="$dangling ${l#"$sandbox"}"
    done < <(find "$sandbox" -type l)
    [[ -z "$dangling" ]] || { echo "dangling links:$dangling" && return 1; }
    printf '%s\n' "$first" >"$LINKS_DIR/$profile"
    rm -rf "$sandbox"
}

# no_cloudstorage <profile> — the link map run_profile saved has no CloudStorage target.
no_cloudstorage() {
    [[ -s "$LINKS_DIR/$1" ]] && ! grep -q 'CloudStorage' "$LINKS_DIR/$1"
}

LINKS_DIR="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-sandbox-links.XXXXXX")"
trap 'rm -rf "$LINKS_DIR"' EXIT

node_for() { if [[ "$1" == work ]]; then echo N6; else echo N5; fi; }

if install_supports_dry_run; then
    for p in $PROFILES; do
        t_expect "$(node_for "$p")" "install --links-only --profile $p into a throwaway HOME, twice" run_profile "$p"
        t_expect N16 "no $p link resolves into CloudStorage" no_cloudstorage "$p"
    done
else
    for p in $PROFILES; do
        if node_landed N5; then
            t_fail "install --links-only --profile $p: ./install still has no --links-only/--profile after N5"
        else
            t_xfail "install --links-only --profile $p: not run, ./install has no --links-only/--profile yet (expected until N5 lands)"
        fi
    done
fi

t_summary "sandbox-install"
