#!/usr/bin/env bash
#
# sandbox-install — link-only install into a throwaway HOME, per profile, twice.
#
# For each profile (home from N5, work from N6):
#   - run `./install --links-only --profile <p>` with HOME set to a fresh
#     mktemp dir, then a second time
#   - assert: both runs exit 0, every link resolves, the second run leaves the
#     same set of links (idempotent)
#   - separately (N16, after the move to ~/repos): no link resolves into
#     CloudStorage
#
# SAFETY: ./install is only executed when its source declares --links-only
# and --profile (module E, node N5). Before that, ./install would run brew
# and macOS settings against the real machine, so it is never called; the
# test reports XFAIL with the node id instead. It is never skipped silently.

set -Eeuo pipefail

# shellcheck source=scripts/test/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

# CI runs one profile per matrix job via DOTFILES_TEST_PROFILES.
PROFILES="${DOTFILES_TEST_PROFILES:-home work}"

t_header "sandbox install"

install_supports_dry_run() {
    grep -q -- '--links-only' "$TEST_REPO/install" && grep -q -- '--profile' "$TEST_REPO/install"
}

# link_map <dir> — "<link> -> <resolved target>" for every symlink under dir.
link_map() {
    local dir=$1 l
    find "$dir" -type l | sort | while IFS= read -r l; do
        printf '%s -> %s\n' "${l#"$dir"}" "$(cd "$(dirname "$l")" && readlink "$l")"
    done
}

# run_profile <profile> — the whole check for one profile; non-zero on any problem.
run_profile() {
    local profile=$1 sandbox first second l dangling
    sandbox="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-sandbox-$profile.XXXXXX")"
    case "$sandbox" in /tmp/* | /var/folders/* | /private/* | "${TMPDIR:-/nonexistent}"*) ;; *)
        echo "refusing: sandbox $sandbox is not under a temp dir"
        return 1
        ;;
    esac
    (cd "$TEST_REPO" && env -u XDG_CONFIG_HOME -u XDG_DATA_HOME HOME="$sandbox" ./install --links-only --profile "$profile") || return 1
    first="$(link_map "$sandbox")"
    (cd "$TEST_REPO" && env -u XDG_CONFIG_HOME -u XDG_DATA_HOME HOME="$sandbox" ./install --links-only --profile "$profile") || return 1
    second="$(link_map "$sandbox")"
    [[ -n "$first" ]] || { echo "no links created" && return 1; }
    [[ "$first" == "$second" ]] || { echo "second run changed the links" && return 1; }
    dangling=""
    while IFS= read -r l; do
        [[ -e "$l" ]] || dangling="$dangling ${l#"$sandbox"}"
    done < <(find "$sandbox" -type l)
    [[ -z "$dangling" ]] || { echo "dangling links:$dangling" && return 1; }
    printf '%s\n' "$first" >"$LINKS_DIR/$profile"
    rm -rf "$sandbox"
}

# no_cloudstorage <profile> — the link map run_profile saved has no CloudStorage target.
no_cloudstorage() {
    [[ -s "$LINKS_DIR/$1" ]] && ! grep -q 'CloudStorage' "$LINKS_DIR/$1"
}

# old_clone_folder_links — a Mac still linked into another clone (the Dropbox
# copy): folder links into it are replaced by real folders, and files that
# clone does not track there (gh's hosts.yml) are copied, not lost.
old_clone_folder_links() {
    local profile=$1 box old
    box="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-sandbox-old.XXXXXX")"
    old="$box/old-clone"
    git clone -q "$TEST_REPO" "$old" && git -C "$old" remote set-url origin https://github.com/shamindras/dotfiles.git
    mkdir -p "$box/home/.config"
    git -C "$old" rm -q --cached --ignore-unmatch config/gh/hosts.yml
    printf 'github.com:\n    user: someone\n' >"$old/config/gh/hosts.yml"
    ln -s "$old/config/gh" "$box/home/.config/gh"
    ln -s "$old/config/sesh" "$box/home/.config/sesh"
    (cd "$TEST_REPO" && env -u XDG_CONFIG_HOME -u XDG_DATA_HOME HOME="$box/home" ./install --links-only --profile "$profile" >/dev/null 2>&1) || { echo "install failed" && return 1; }
    [[ -d "$box/home/.config/gh" && ! -L "$box/home/.config/gh" ]] || { echo "gh still a folder link" && return 1; }
    cmp -s "$old/config/gh/hosts.yml" "$box/home/.config/gh/hosts.yml" || { echo "hosts.yml not kept" && return 1; }
    [[ "$(readlink "$box/home/.config/gh/config.yml")" == "$TEST_REPO"/config/gh/config.yml ]] || { echo "config.yml not linked to this clone" && return 1; }
    [[ -L "$box/home/.config/sesh/sesh.toml" && -f "$old/config/sesh/sesh.toml" && ! -L "$old/config/sesh/sesh.toml" ]] || { echo "sesh not relinked, or the old clone was touched" && return 1; }
    rm -rf "$box"
}

LINKS_DIR="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-sandbox-links.XXXXXX")"
trap 'rm -rf "$LINKS_DIR"' EXIT

# sesh_sessions <profile> — the sandbox's linked sesh.toml lists exactly the
# profile's sessions (needs sesh; the untracked import file is created first,
# as the sesh unit's setup step would).
sesh_sessions() {
    local profile=$1 sandbox want got
    command -v sesh >/dev/null 2>&1 || { echo "sesh not installed" && return 1; }
    sandbox="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-sandbox-sesh.XXXXXX")"
    (cd "$TEST_REPO" && env -u XDG_CONFIG_HOME -u XDG_DATA_HOME HOME="$sandbox" ./install --links-only --profile "$profile" >/dev/null) || return 1
    printf '# local\n' >"$sandbox/.config/dotfiles/sesh.local.toml"
    want="$(sed -n '/"sesh_sessions"/,/]/p' "$TEST_REPO/generated/$profile/resolved.json" | grep -oE '"[a-z]+"' | grep -v sesh_sessions | tr -d '"' | sort | tr '\n' ' ')"
    got="$(env -i HOME="$sandbox" PATH="$PATH" REPOS_DIR="$sandbox/repos" NOTES_DIR="$sandbox/notes" \
        sesh -C "$sandbox/.config/sesh/sesh.toml" list -c --json | grep -oE '"Name": *"[^"]+"' | sed -E 's/.*"([^"]+)"$/\1/' | sort | tr '\n' ' ')"
    rm -rf "$sandbox"
    [[ -n "$want" && "$want" == "$got" ]] || { echo "want: $want got: $got" && return 1; }
}

node_for() { if [[ "$1" == work ]]; then echo N6; else echo N5; fi; }

if install_supports_dry_run; then
    t_expect N12 "folder links into an older clone are replaced; untracked files kept" old_clone_folder_links "${PROFILES%% *}"
    for p in $PROFILES; do
        t_expect "$(node_for "$p")" "install --links-only --profile $p into a throwaway HOME, twice" run_profile "$p"
        t_expect N16 "no $p link resolves into CloudStorage" no_cloudstorage "$p"
        if command -v sesh >/dev/null 2>&1; then
            t_expect N10 "sesh in a throwaway HOME lists the $p sessions" sesh_sessions "$p"
        else
            t_skip "sesh sessions for $p: sesh not installed here"
        fi
    done
else
    for p in $PROFILES; do
        if node_landed N5; then
            t_fail "install --links-only --profile $p: ./install still has no --links-only/--profile after N5"
        else
            t_xfail "install --links-only --profile $p: not run, ./install has no --links-only/--profile yet (expected until N5 lands)"
        fi
    done
fi

t_summary "sandbox-install"
