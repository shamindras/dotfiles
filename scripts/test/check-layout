#!/usr/bin/env bash
#
# check-layout — the repo's top level matches the allow-list (plan: lean top
# level), no secret-shaped value is tracked in config/gh/hosts.yml (gh
# rewrites that file; tokens must stay in the macOS keychain), and no
# per-machine *.local file sits inside the repo tree. Also: no tracked file is
# ignored, and local Claude Code state and login files are ignored.

set -Eeuo pipefail

# shellcheck source=scripts/test/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

cd "$TEST_REPO"
ALLOWED=(
    CLAUDE.md README.md justfile manifest.json bootstrap install
    config scripts generated submods docs .github
    .claude .gitattributes .gitignore .gitmodules .markdownlint-cli2.yaml
    .prettierignore .prettierrc.yaml .stylua.toml .taplo.toml .vscode
)

t_header "layout"
extra=""
for top in $(git ls-files | cut -d/ -f1 | sort -u); do
    found=0
    for a in "${ALLOWED[@]}"; do [[ "$top" == "$a" ]] && found=1 && break; done
    [[ $found -eq 1 ]] || extra="$extra $top"
done
if [[ -z "$extra" ]]; then t_pass "top level matches the allow-list"; else t_fail "not on the allow-list:$extra"; fi

if git grep -nIqE 'oauth_token|gh[opsur]_[A-Za-z0-9]{20,}' -- config/gh/hosts.yml; then
    t_fail "config/gh/hosts.yml contains a token-shaped value: remove it and run gh auth login (keychain)"
else
    t_pass "no token in config/gh/hosts.yml"
fi

# Per-machine files (identity, local sessions, overrides) live outside the
# repo, under ~/.config/dotfiles; none may hide in the working tree, tracked
# or ignored, where a fresh clone would silently lack them.
local_files="$(git ls-files --others --ignored --exclude-standard --cached -- ':!.claude' | grep -E '(^|/)[^/]*\.local(\.[a-z]+)?$|(^|/)config\.local$' || true)"
if [[ -z "$local_files" ]]; then
    t_pass "no per-machine *.local files inside the repo"
else
    t_fail "per-machine files inside the repo: $(printf '%s' "$local_files" | tr '\n' ' ')"
fi

# gh's login state used to live in the repo (config/gh/hosts.yml, now
# untracked and ignored). After the move (N16) it lives only in ~/.config/gh.
no_gh_login_in_repo() { [[ ! -e config/gh/hosts.yml ]]; }
t_expect N16 "no gh login state (config/gh/hosts.yml) inside the repo" no_gh_login_in_repo

# Ignore rules: checked with the repo's .gitignore alone (a fresh clone,
# before install links a global ignore) and with config/git/ignore as the
# global ignore (what install sets up).
t_header "gitignore"
for global in /dev/null "$TEST_REPO/config/git/ignore"; do
    label="repo .gitignore"
    [[ "$global" == /dev/null ]] || label="repo .gitignore plus config/git/ignore"
    bad="$(git -c core.excludesFile="$global" ls-files -ci --exclude-standard)"
    if [[ -z "$bad" ]]; then
        t_pass "no tracked file is ignored ($label)"
    else
        t_fail "tracked but ignored ($label): $(printf '%s' "$bad" | tr '\n' ' ')"
    fi
done
for f in .claude/settings.local.json .claude/x.local.md .claude/scheduled_tasks.lock config/gh/hosts.yml .env; do
    if git -c core.excludesFile=/dev/null check-ignore -q --no-index "$f"; then
        t_pass "ignored by the repo alone: $f"
    else
        t_fail "not ignored by the repo's .gitignore: $f"
    fi
done

t_summary "check-layout"
