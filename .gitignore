# Ignore rules for this dotfiles repo. Only rules that can match something
# here are kept; scripts/test/check-gitignore fails if a tracked file is
# ignored or if local Claude Code state is not.

### macOS ###
.DS_Store
.AppleDouble
.LSOverride
._*
*.icloud
# Icon must end with two \r
Icon

### Claude Code: local, per-machine state (settings.json is shared) ###
.claude/settings.local.json
.claude/*.local.*
.claude/scheduled_tasks.lock

### Secrets and login state ###
# gh writes its login state here (~/.config/gh/hosts.yml links to it).
/config/gh/hosts.yml
.env
.env.*
.netrc
.httr-oauth
.Renviron

### Shell ###
# zsh history lands in $XDG_STATE_HOME/zsh/history; this catches a shell that
# starts before .zshenv sets XDG_STATE_HOME.
.zsh_history
config/zsh/.zsh_sessions
*.zwc
*.zwc.old

### Python (repo scripts and the REPL) ###
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

### R ###
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/

### Vim and Neovim ###
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
*~
[._]*.un~
# Neovim compiles spell files from the tracked .add word lists.
*.spl

### Tool state written into config folders ###
config/brew/Brewfile.lock.json
# GNU parallel caches per-host data here.
config/parallel/tmp/
# yazi: ya pkg reproduces plugins and flavors from package.toml (pinned revs
# and hashes); only the two hand-written plugins are tracked.
config/yazi/plugins/*
!config/yazi/plugins/flavor-picker.yazi/
!config/yazi/plugins/smart-archive-enter.yazi/
config/yazi/flavors/*
