{
  "schema_version": 1,
  "note": "The one hand-maintained declaration. Edit, then run just manifest_render (or just manifest_set).",
  "taps": {
    "felixkratz/formulae": {
      "trusted": true
    },
    "nikitabobko/tap": {
      "trusted": true
    }
  },
  "modules": {
    "apps": {
      "note": "Browsers, password manager, Claude, meetings, and the macOS apps the leader opens.",
      "cask": ["1password-cli", "claude-code", "google-chrome", "microsoft-teams", "zoom"]
    },
    "core": {
      "note": "Shell, navigation and everyday command-line tools.",
      "brew": [
        "bat-extras",
        "broot",
        "coreutils",
        "direnv",
        "duf",
        "dust",
        "eza",
        "fd",
        "fzf",
        "gum",
        "httpie",
        "hyperfine",
        "jq",
        "just",
        "ouch",
        "p7zip",
        "ripgrep-all",
        "rsync",
        "unar",
        "xdg-ninja",
        "yq",
        "zoxide"
      ]
    },
    "data-science": {
      "note": "Python and R tooling, databases, publishing.",
      "brew": ["duckdb", "gdal", "uv"],
      "cask": ["quarto", "xquartz"]
    },
    "desktop": {
      "note": "Window manager, status bar, keyboard automation and launcher.",
      "cask": ["raycast", "scroll-reverser", "shottr"]
    },
    "docs": {
      "note": "Pandoc, Typst, LaTeX, PDF and image tools, spell checkers, reference manager.",
      "brew": [
        "aspell",
        "ghostscript",
        "graphviz",
        "hunspell",
        "imagemagick",
        "pandoc",
        "pandoc-crossref",
        "poppler",
        "qpdf",
        "typst"
      ],
      "cask": ["inkscape", "libreoffice", "mactex", "zotero"]
    },
    "editor": {
      "note": "Neovim and what its config needs to build parsers and run Lua tooling.",
      "brew": ["lua", "tree-sitter-cli"]
    },
    "fonts-extra": {
      "note": "Fonts not referenced by a config.",
      "cask": [
        "font-cascadia-code-nf",
        "font-commit-mono-nerd-font",
        "font-fira-code-nerd-font",
        "font-hack-nerd-font",
        "font-hasklug-nerd-font",
        "font-input",
        "font-iosevka-nerd-font",
        "font-lilex-nerd-font",
        "font-maple-mono",
        "font-monaspice-nerd-font",
        "font-monoid",
        "font-roboto-mono-nerd-font",
        "font-sauce-code-pro-nerd-font",
        "font-udev-gothic-nf",
        "font-victor-mono"
      ]
    },
    "git": {
      "note": "Version control, signing and SSH.",
      "brew": ["commitizen", "gnupg", "prek"]
    },
    "lint": {
      "note": "Formatters and linters used by nvim and the repo's own recipes.",
      "brew": ["jsonlint", "prettier", "shellcheck", "shfmt", "taplo", "yamllint"]
    },
    "notes": {
      "note": "Zettelkasten."
    },
    "personal": {
      "note": "Media, downloads, messaging, e-books.",
      "cask": ["calibre", "dropbox", "notunes", "oracle-jdk"],
      "brew": [
        "djvulibre",
        "exiftool",
        "ffmpeg",
        "netlify-cli",
        "oxipng",
        "speedtest-cli",
        "subversion",
        "taskwarrior-tui",
        "tesseract",
        "yt-dlp"
      ]
    },
    "review": {
      "note": "Kept on the package review; nothing installed depends on them. Home only.",
      "brew": [
        "gobject-introspection",
        "libass",
        "libmng",
        "openssl@3.0",
        "perl",
        "php",
        "poppler-qt5",
        "shared-mime-info",
        "srt",
        "tcl-tk",
        "unbound"
      ]
    },
    "terminal": {
      "note": "Terminal apps and the fonts they are configured to use.",
      "cask": ["font-jetbrains-mono-nerd-font", "font-sf-pro", "font-symbols-only-nerd-font"]
    }
  },
  "units": {
    "1password": {
      "module": "apps",
      "cask": ["1password"],
      "app": {
        "path": "/Applications/1Password.app",
        "bundle_id": "com.1password.1password",
        "leader": "1",
        "label": "1password",
        "process": "1Password",
        "workspace": "1",
        "quit_workspace": "B"
      }
    },
    "aerospace": {
      "module": "desktop",
      "cask": ["nikitabobko/tap/aerospace"],
      "links": {
        "${XDG_CONFIG_HOME}/aerospace": "config/aerospace"
      },
      "requires": ["borders", "sketchybar"]
    },
    "atuin": {
      "module": "core",
      "brew": ["atuin"],
      "links": {
        "${XDG_CONFIG_HOME}/atuin": "config/atuin"
      }
    },
    "bat": {
      "module": "core",
      "brew": ["bat"],
      "links": {
        "${XDG_CONFIG_HOME}/bat": "config/bat"
      },
      "setup": [
        {
          "command": "command bat cache --build",
          "description": "build the bat theme cache",
          "needs": ["bat"]
        }
      ]
    },
    "bin": {
      "module": "core",
      "note": "Personal scripts on PATH.",
      "links": {
        "${XDG_CONFIG_HOME}/bin": "config/bin"
      }
    },
    "booklib": {
      "module": "personal",
      "note": "config/booklib is run in place by config/bin scripts.",
      "requires": ["1password-cli", "djvulibre", "exiftool", "imagemagick", "poppler", "tesseract"]
    },
    "books": {
      "module": "apps",
      "note": "Ships with macOS.",
      "app": {
        "path": "/System/Applications/Books.app",
        "bundle_id": "com.apple.iBooksX",
        "leader": "i",
        "label": "books",
        "process": "Books",
        "workspace": "I",
        "quit_workspace": "B"
      }
    },
    "borders": {
      "module": "desktop",
