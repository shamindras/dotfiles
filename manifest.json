        "${XDG_CONFIG_HOME}/wget": "config/wget"
      }
    },
    "yazi": {
      "module": "core",
      "brew": ["yazi"],
      "links": {
        "${XDG_CONFIG_HOME}/yazi": "config/yazi"
      },
      "setup": [
        {
          "command": "ya pkg install",
          "description": "install yazi plugins and flavors",
          "needs": ["ya"]
        }
      ],
      "requires": ["djvulibre", "ffmpeg", "imagemagick", "ouch", "p7zip", "poppler", "unar"]
    },
    "zk": {
      "module": "notes",
      "brew": ["zk"],
      "links": {
        "${XDG_CONFIG_HOME}/zk": "config/zk"
      },
      "setup": [
        {
          "command": "./scripts/setup/setup-zk",
          "description": "set up the zk notebook",
          "needs": ["zk"]
        }
      ]
    },
    "zsh": {
      "module": "core",
      "note": "System zsh; config only.",
      "links": {
        "${HOME}/.zshenv": "config/zsh/.zshenv",
        "${XDG_CONFIG_HOME}/zsh": "config/zsh"
      }
    }
  },
  "profiles": {
    "home": {
      "note": "The home Mac. Every module is on.",
      "modules": [
        "apps",
        "core",
        "data-science",
        "desktop",
        "docs",
        "editor",
        "fonts-extra",
        "git",
        "lint",
        "notes",
        "personal",
        "review",
        "terminal"
      ],
      "roles": {
        "browser": "firefox"
      },
      "settings": {
        "repos_dir": "$HOME/repos",
        "notes_dir": "$HOME/Dropbox/notes",
        "remote_login": true,
        "quarantine_warning": false
      }
    }
  }
}
