#!/usr/bin/env bash
#
# bootstrap — fresh-Mac entry point. Clone anywhere over HTTPS, then run it:
#
#   git clone https://github.com/shamindras/dotfiles.git ~/repos/dotfiles
#   ~/repos/dotfiles/bootstrap --profile home     # or --profile work
#
# Phases (idempotent; each detects, then skips or does the work):
#   1. Homebrew: install it if missing, then load `brew shellenv` into this
#      run, so no new terminal is needed.
#   2. Hand off to ./install with the same arguments.
#
# Needs no SSH key and no cloud-synced folder; nothing prompts except Homebrew's
# own installer and sudo. Re-runs are safe; Ctrl-C aborts cleanly.
# Flags are passed through to ./install (--profile, --links-only, --dry-run,
# --no-hints; see ./install --help).

set -Eeuo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=scripts/_lib/step.sh
source "$BASEDIR/scripts/_lib/step.sh"

trap 'printf "\n⚠️  bootstrap interrupted; re-run ./bootstrap to resume.\n" >&2; exit 130' INT

load_brew() {
    local b
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [[ -x "$b" ]]; then
            eval "$("$b" shellenv)"
            return 0
        fi
    done
    return 1
}

dry=0
for a in "$@"; do
    case "$a" in --dry-run | --links-only) dry=1 ;; esac
done

# ----- Phase 1: Homebrew -----
if command -v brew >/dev/null 2>&1 || load_brew; then
    step_outer 1 2 🍺 "Homebrew present ($(brew --version | head -1))"
elif [[ $dry -eq 1 ]]; then
    step_outer 1 2 🍺 "Homebrew missing; a real run would install it"
else
    step_outer 1 2 🍺 "Installing Homebrew"
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    load_brew || {
        echo "❌ Homebrew installed but brew was not found in /opt/homebrew or /usr/local" >&2
        exit 1
    }
    step_done 🍺 "Homebrew installed and loaded into this run"
fi

# ----- Phase 2: Hand-off to ./install -----
step_outer 2 2 🤝 "Handing off to ./install"
exec "$BASEDIR/install" "$@"
